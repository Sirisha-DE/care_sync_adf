{
	"$schema": "http://schema.management.azure.com/schemas/2015-01-01/deploymentTemplate.json#",
	"contentVersion": "1.0.0.0",
	"parameters": {
		"factoryName": {
			"type": "string",
			"metadata": "Data Factory name",
			"defaultValue": "AzureDataFactorySirisha"
		},
		"linkazurekeyvault_properties_typeProperties_baseUrl": {
			"type": "string",
			"defaultValue": "https://caresynckeyvaults.vault.azure.net/"
		},
		"linkazuresqldb_properties_typeProperties_server": {
			"type": "string",
			"defaultValue": "deprojectserver.database.windows.net"
		},
		"linkazuresqldb_properties_typeProperties_database": {
			"type": "string",
			"defaultValue": "DE"
		},
		"linkazuresqldb_properties_typeProperties_userName": {
			"type": "string",
			"defaultValue": "deprojectserveradmin"
		},
		"linkpostgresql_properties_typeProperties_server": {
			"type": "string",
			"defaultValue": "ep-misty-forest-bdvzc0xk-pooler.c-8.us-east-2.aws.neon.tech"
		},
		"linkpostgresql_properties_typeProperties_database": {
			"type": "string",
			"defaultValue": "neondb"
		},
		"linkpostgresql_properties_typeProperties_username": {
			"type": "string",
			"defaultValue": "neondb_owner"
		},
		"linksourcede_properties_typeProperties_url": {
			"type": "string",
			"defaultValue": "https://adlssirisha.dfs.core.windows.net/"
		},
		"containerUri": {
			"type": "string",
			"metadata": "URI to storage account containing linked ARM templates"
		},
		"containerSasToken": {
			"type": "string",
			"metadata": "Sas token to storage account containing linked ARM templates"
		}
	},
	"variables": {
		"factoryId": "[concat('Microsoft.DataFactory/factories/', parameters('factoryName'))]"
	},
	"resources": [
		{
			"name": "AzureDataFactorySirisha_ArmTemplate_0",
			"type": "Microsoft.Resources/deployments",
			"apiVersion": "2024-03-01",
			"properties": {
				"mode": "incremental",
				"templateLink": {
					"uri": "[concat(parameters('containerUri'), '/ArmTemplate_0.json', parameters('containerSasToken'))]",
					"contentVersion": "1.0.0.0"
				},
				"parameters": {
					"factoryName": {
						"value": "[parameters('factoryName')]"
					},
					"linkazurekeyvault_properties_typeProperties_baseUrl": {
						"value": "[parameters('linkazurekeyvault_properties_typeProperties_baseUrl')]"
					},
					"linksourcede_properties_typeProperties_url": {
						"value": "[parameters('linksourcede_properties_typeProperties_url')]"
					},
					"linkazuresqldb_properties_typeProperties_server": {
						"value": "[parameters('linkazuresqldb_properties_typeProperties_server')]"
					},
					"linkazuresqldb_properties_typeProperties_database": {
						"value": "[parameters('linkazuresqldb_properties_typeProperties_database')]"
					},
					"linkazuresqldb_properties_typeProperties_userName": {
						"value": "[parameters('linkazuresqldb_properties_typeProperties_userName')]"
					},
					"linkpostgresql_properties_typeProperties_server": {
						"value": "[parameters('linkpostgresql_properties_typeProperties_server')]"
					},
					"linkpostgresql_properties_typeProperties_database": {
						"value": "[parameters('linkpostgresql_properties_typeProperties_database')]"
					},
					"linkpostgresql_properties_typeProperties_username": {
						"value": "[parameters('linkpostgresql_properties_typeProperties_username')]"
					}
				}
			},
			"dependsOn": []
		}
	]
}